#!/usr/bin/env python3
"""Serve the factory dashboard on this machine only.

Usage: dashboard [port]        (default 8000), then open http://127.0.0.1:<port>/dashboard.html

Serves factory/ at /, and, read-only, the repo's local tickets (.scratch/) at
/.scratch/, so the dashboard can show a local ticket live: its Status and the
factory's comments. Binds 127.0.0.1, unlike `python3 -m http.server`, which
listens on every interface.

/_subscriptions.json feeds the Subscription view. It reads
~/.config/factory/subscriptions.json (or $XDG_CONFIG_HOME/factory/...), which
lists what you pay and every repo the factory runs in, since one subscription
pays for all of them:

  {"subscriptions": [{"name": "Claude Max 5x", "agent": "claude", "usd_per_month": 100,
                      "since": "2026-09"}],
   "projects": ["~/code/app", "~/code/api"]}

`since` (YYYY-MM) is optional. This repo is always included. Without the file
the endpoint answers {"configured": false} and the view says how to set it up.

The same subscriptions pay for work outside the factory, so the endpoint also
prices every other Claude Code transcript (~/.claude/projects) and Codex
session (the homes bin/job reads) on this machine, month by month: `outside`.
A session whose first lines name a `Job folder: .../factory/jobs/...` belongs to
a job and is left out, since the job already counts it. Reading 1 GB of sessions
takes a while, so a background thread does it and caches each file's result in
~/.cache/factory/usage.json (keyed by size and mtime); until the first pass is
done `outside.status` is "scanning". `"outside": false` in subscriptions.json
turns it off.
"""

import functools
import hashlib
import http.server
import json
import os
import re
import sys
import threading
import time
from datetime import datetime
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
FACTORY = REPO / "factory"
SCRATCH = REPO / ".scratch"
SUBSCRIPTIONS = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "factory" / "subscriptions.json"
JOB_KEYS = ("id", "stage", "started", "ended", "cost_usd", "cost_by_agent")
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "factory" / "usage.json"
JOB_FOLDER = re.compile(r"Job folder: \S*/factory/jobs/")
RESCAN_SECONDS = 300
CACHE_VERSION = 1  # bump when a file's cached result changes shape


def config():
    return json.loads((FACTORY / "config.json").read_text())


def claude_files():
    root = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "projects"
    yield from root.glob("*/*.jsonl")
    yield from root.glob("*/*/subagents/*.jsonl")


def codex_files(cfg):
    """Same homes as bin/job: $CODEX_HOME or ~/.codex, Orca's accounts, config.json codex_homes."""
    homes = [Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")]
    homes += sorted((Path.home() / ".config" / "orca" / "codex-accounts").glob("*/home"))
    homes += [Path(p).expanduser() for p in cfg.get("codex_homes", [])]
    for home in dict.fromkeys(homes):
        yield from (home / "sessions").glob("*/*/*/rollout-*.jsonl")


def month(ts):
    """Local YYYY-MM of an ISO timestamp, as the page buckets job starts."""
    return datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone().strftime("%Y-%m")


def claude_user_text(entry):
    msg = entry.get("message")
    if entry.get("type") != "user" or not isinstance(msg, dict):
        return ""
    content = msg.get("content")
    if isinstance(content, str):
        return content
    return " ".join(b.get("text", "") for b in content or [] if isinstance(b, dict))


def scan_claude(path, prices):
    """{factory, cwd, msgs: {message id: [month, usd]}, unpriced: {model: {month: tokens}}}.

    Messages are kept by id so a message copied into a resumed session counts once."""
    out = {"factory": False, "cwd": None, "msgs": {}, "unpriced": {}}
    with path.open(errors="replace") as f:
        for i, line in enumerate(f):
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if not isinstance(entry, dict):
                continue
            out["cwd"] = out["cwd"] or entry.get("cwd")
            if i <= 40 and JOB_FOLDER.search(claude_user_text(entry)):
                out["factory"] = True
                return out
            msg = entry.get("message")
            if entry.get("type") != "assistant" or not isinstance(msg, dict) or not msg.get("usage"):
                continue
            u, model = msg["usage"], msg.get("model")
            split = u.get("cache_creation") or {}
            write_1h = split.get("ephemeral_1h_input_tokens", 0) or 0
            write_5m = (u.get("cache_creation_input_tokens", 0) or 0) - write_1h
            tokens = (u.get("input_tokens", 0) or 0) + (u.get("output_tokens", 0) or 0) + write_5m + write_1h \
                + (u.get("cache_read_input_tokens", 0) or 0)
            if not tokens:
                continue
            p = prices.get(model)
            if not p:
                if entry.get("timestamp"):
                    by = out["unpriced"].setdefault(str(model), {})
                    m = month(entry["timestamp"])
                    by[m] = by.get(m, 0) + tokens
                continue
            usd = ((u.get("input_tokens", 0) or 0) * p["input"] + (u.get("output_tokens", 0) or 0) * p["output"]
                   + write_5m * p["cache_write_5m"] + write_1h * p["cache_write_1h"]
                   + (u.get("cache_read_input_tokens", 0) or 0) * p["cache_read"]) / 1e6
            if entry.get("timestamp"):
                out["msgs"][msg.get("id") or f"{path}:{i}"] = [month(entry["timestamp"]), usd]
    return out


def codex_usd(u, p):
    cached = u.get("cached_input_tokens", 0) or 0
    written = u.get("cache_write_input_tokens", 0) or 0
    fresh = (u.get("input_tokens", 0) or 0) - cached - written
    return (fresh * p["input"] + cached * p["cached_input"] + written * p.get("cache_write", p["input"])
            + (u.get("output_tokens", 0) or 0) * p["output"]) / 1e6


def scan_codex(path, prices):
    """{factory, cwd, sid, tokens, months: {month: usd}, unpriced: {model: {month: tokens}}}.

    token_count events carry running totals, so each event adds the growth since
    the one before, priced at the model of the turn it falls in."""
    out = {"factory": False, "cwd": None, "sid": path.stem, "tokens": 0, "months": {}, "unpriced": {}}
    model, last = None, {}
    with path.open(errors="replace") as f:
        for i, line in enumerate(f):
            if i <= 60 and JOB_FOLDER.search(line):
                out["factory"] = True
                return out
            if '"session_meta"' not in line[:80] and '"turn_context"' not in line[:80] and '"token_count"' not in line:
                continue
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            p = entry.get("payload") or {}
            if entry.get("type") == "session_meta":
                out["sid"] = p.get("session_id") or p.get("id") or out["sid"]
                out["cwd"] = out["cwd"] or p.get("cwd")
            elif entry.get("type") == "turn_context":
                model = p.get("model") or model
            elif p.get("type") == "token_count" and p.get("info") and p["info"].get("total_token_usage"):
                total = p["info"]["total_token_usage"]
                grown = {k: (total.get(k, 0) or 0) - (last.get(k, 0) or 0) for k in total}
                last = total
                out["tokens"] = total.get("total_tokens", 0) or 0
                if (grown.get("total_tokens", 0) or 0) <= 0 or not entry.get("timestamp"):
                    continue
                m = month(entry["timestamp"])
                if model not in prices:
                    by = out["unpriced"].setdefault(str(model), {})
                    by[m] = by.get(m, 0) + grown["total_tokens"]
                    continue
                out["months"][m] = out["months"].get(m, 0) + codex_usd(grown, prices[model])
    return out


class Outside:
    """Sessions outside factory jobs, priced per month; refreshed by a background thread."""

    def __init__(self):
        self.lock = threading.Lock()
        self.result = None
        self.started = False

    def get(self):
        with self.lock:
            if not self.started:
                self.started = True
                threading.Thread(target=self.loop, daemon=True).start()
            return self.result or {"status": "scanning"}

    def loop(self):
        while True:
            try:
                result = self.scan()
            except Exception as err:  # keep serving the rest of the view
                result = {"status": "error", "error": str(err)}
            with self.lock:
                self.result = result
            time.sleep(RESCAN_SECONDS)

    def scan(self):
        cfg = config()
        prices = cfg["prices_usd_per_mtok"]
        key = hashlib.sha256(json.dumps([CACHE_VERSION, prices], sort_keys=True).encode()).hexdigest()
        try:
            cache = json.loads(CACHE.read_text())
            files = cache["files"] if cache.get("prices") == key else {}
        except (OSError, ValueError, KeyError):
            files = {}
        fresh = {}
        for kind, paths in (("claude", claude_files()), ("codex", codex_files(cfg))):
            for path in paths:
                try:
                    st = path.stat()
                except OSError:
                    continue
                stamp = [st.st_size, st.st_mtime_ns]
                old = files.get(str(path))
                if old and old["stamp"] == stamp:
                    fresh[str(path)] = old
                    continue
                try:
                    data = (scan_claude if kind == "claude" else scan_codex)(path, prices)
                except OSError:
                    continue
                fresh[str(path)] = {"stamp": stamp, "kind": kind, **data}
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        tmp = CACHE.with_suffix(".tmp")
        tmp.write_text(json.dumps({"prices": key, "files": fresh}))
        tmp.replace(CACHE)
        return summarize(fresh)


def summarize(files):
    """{status, months: {month: {claude, codex}}, by_cwd: [...], unpriced: {month: {model: tokens}}, factory_sessions}."""
    months, cwds, unpriced, seen_msgs, codex_best = {}, {}, {}, set(), {}
    factory_sessions = 0

    def add(m, agent, usd, cwd):
        row = months.setdefault(m, {"claude": 0.0, "codex": 0.0})
        row[agent] += usd
        c = cwds.setdefault(cwd or "?", {"cwd": cwd or "?", "claude": 0.0, "codex": 0.0, "sessions": set()})
        c[agent] += usd

    for path, f in sorted(files.items()):
        if f["factory"]:
            factory_sessions += 1
            continue
        for model, by in f["unpriced"].items():
            for m, n in by.items():
                row = unpriced.setdefault(m, {})
                row[model] = row.get(model, 0) + n
        if f["kind"] == "claude":
            counted = False
            for mid, (m, usd) in f["msgs"].items():
                if mid in seen_msgs:
                    continue
                seen_msgs.add(mid)
                add(m, "claude", usd, f["cwd"])
                counted = True
            if counted:
                cwds[f["cwd"] or "?"]["sessions"].add(path)
        else:
            # One session can sit in two homes; the longest copy counts.
            best = codex_best.get(f["sid"])
            if not best or f["tokens"] > best["tokens"]:
                codex_best[f["sid"]] = {**f, "path": path}
    for f in codex_best.values():
        for m, usd in f["months"].items():
            add(m, "codex", usd, f["cwd"])
        if f["months"]:
            cwds[f["cwd"] or "?"]["sessions"].add(f["path"])
    by_cwd = [{**c, "sessions": len(c["sessions"])} for c in cwds.values()]
    by_cwd.sort(key=lambda c: -(c["claude"] + c["codex"]))
    return {"status": "ready", "months": months, "by_cwd": by_cwd, "unpriced": unpriced,
            "factory_sessions": factory_sessions}


OUTSIDE = Outside()


def subscriptions():
    """The subscriptions and, per listed repo, the cost fields of its jobs; None without a config."""
    if not SUBSCRIPTIONS.is_file():
        return None
    cfg = json.loads(SUBSCRIPTIONS.read_text())
    paths = [REPO] + [Path(p).expanduser().resolve() for p in cfg.get("projects", [])]
    projects, seen = [], set()
    for path in paths:
        if path in seen:
            continue
        seen.add(path)
        jobs = []
        for f in sorted((path / "factory" / "jobs").glob("[!_]*/job.json")):
            try:
                job = json.loads(f.read_text())
            except (OSError, ValueError):
                continue
            jobs.append({k: job.get(k) for k in JOB_KEYS})
        projects.append({"name": path.name, "jobs": jobs, "missing": not (path / "factory").is_dir()})
    return {"subscriptions": cfg.get("subscriptions", []), "projects": projects, "config": str(SUBSCRIPTIONS),
            "outside": OUTSIDE.get() if cfg.get("outside", True) else {"status": "off"}}


class Handler(http.server.SimpleHTTPRequestHandler):
    def do_GET(self):
        if self.path.split("?", 1)[0] == "/_subscriptions.json":
            try:
                data = subscriptions()
            except ValueError as err:
                return self.send_error(500, f"{SUBSCRIPTIONS}: {err}")
            # No config is an answer, not a 404: the page reads a 404 as a server
            # started before this endpoint existed.
            body = json.dumps(data or {"configured": False, "config": str(SUBSCRIPTIONS)}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        super().do_GET()

    def translate_path(self, path):
        clean = path.split("?", 1)[0].split("#", 1)[0]
        if clean == "/.scratch" or clean.startswith("/.scratch/"):
            saved, self.directory = self.directory, str(SCRATCH)
            try:
                return super().translate_path(clean[len("/.scratch"):] or "/")
            finally:
                self.directory = saved
        return super().translate_path(path)

    def end_headers(self):
        self.send_header("Cache-Control", "no-store")
        super().end_headers()

    def log_message(self, *args):
        pass  # the dashboard polls; don't fill the terminal


def main(argv):
    port = int(argv[0]) if argv else 8000
    handler = functools.partial(Handler, directory=str(FACTORY))
    server = http.server.ThreadingHTTPServer(("127.0.0.1", port), handler)
    print(f"dashboard: http://127.0.0.1:{port}/dashboard.html (Ctrl+C to stop)", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main(sys.argv[1:])
