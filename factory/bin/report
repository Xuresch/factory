#!/usr/bin/env python3
"""Report this machine's factories to the factory hub.

Usage:
  report                     one push, then exit (prints what it sent)
  report --watch             push every interval_seconds, forever (the systemd service)
  report --full              one push with full=true
  report --dry-run           print the JSON it would send (file contents cut to 80
                             chars), send nothing, write no state
  report --no-outside        leave out the outside-factory usage scan (handy with --dry-run)
  report --install-service   write ~/.config/systemd/user/factory-report.service and
                             print the systemctl commands to enable it (runs none)

Config: ~/.config/factory/hub.json (or $XDG_CONFIG_HOME/factory/hub.json):

  {"url": "https://factory.example.net", "token": "...", "machine": "niko-laptop",
   "projects": ["~/code/app"], "interval_seconds": 5, "outside": true}

`token` may come from $FACTORY_HUB_TOKEN and `url` from $FACTORY_HUB_URL; `machine`
defaults to the hostname. The repos reported are the one this script lives in, every
project in subscriptions.json, and every project listed here, as far as they have a
factory/ directory. Each repo is named owner/name from its git origin (local/<dir>
without one).

It only reads the files bin/job already writes: factory/jobs/[!_]*/job.json, every *.md
under a job folder, factory/config.json, and a job's local ticket (.scratch/...). It
remembers what the hub has in ~/.cache/factory/report-state.json (hashes only) and
sends just what changed. A full push goes out the first time, after a failed push,
when the hub asks for one, and every 10 minutes. The state is written only once the
hub answered 2xx. Outside usage (bin/session_usage.py's scan of the other Claude Code
and Codex sessions, the one bin/dashboard serves) is read on its own thread every
5 minutes in --watch.

Exit codes: 0 ok, 1 push failed, 2 no config. The contract is hub/PROTOCOL.md.
"""

import gzip
import hashlib
import json
import os
import re
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

sys.dont_write_bytecode = True  # no __pycache__ in factory/bin of the repos the factory runs in
sys.path.insert(0, str(Path(__file__).resolve().parent))
import session_usage  # noqa: E402  (factory/bin/session_usage.py)

REPO = Path(__file__).resolve().parents[2]
FULL_EVERY = 600
OUTSIDE_EVERY = 300
DRY_CUT = 80
SERVICE = "factory-report.service"


def config_path():
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "factory" / "hub.json"


def subscriptions_path():
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "factory" / "subscriptions.json"


def state_path():
    return Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "factory" / "report-state.json"


def sha(data):
    if isinstance(data, str):
        data = data.encode()
    return hashlib.sha1(data).hexdigest()


def say(msg):
    print(f"report: {msg}", flush=True)


# ---- config ----------------------------------------------------------------

class NoConfig(Exception):
    pass


def read_json_file(path):
    """The parsed file, None when it is missing; ValueError when it is not JSON."""
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return None


def load_config(dry_run=False):
    path = config_path()
    try:
        cfg = read_json_file(path)
    except (OSError, ValueError) as err:
        raise NoConfig(f"{path}: {err}")
    if cfg is not None and not isinstance(cfg, dict):
        raise NoConfig(f"{path}: expected a JSON object")
    cfg = cfg or {}
    cfg["url"] = os.environ.get("FACTORY_HUB_URL") or cfg.get("url")
    cfg["token"] = os.environ.get("FACTORY_HUB_TOKEN") or cfg.get("token")
    if not cfg["url"] or not (cfg["token"] or dry_run):
        raise NoConfig(f"no hub configured: put {{\"url\": ..., \"token\": ...}} in {path} "
                       "(or set FACTORY_HUB_URL and FACTORY_HUB_TOKEN)")
    cfg["url"] = cfg["url"].rstrip("/")
    cfg["machine"] = cfg.get("machine") or socket.gethostname()
    try:
        cfg["interval_seconds"] = max(1.0, float(cfg.get("interval_seconds", 5)))
    except (TypeError, ValueError):
        cfg["interval_seconds"] = 5.0
    return cfg


# ---- identity --------------------------------------------------------------

GITHUB = re.compile(r"^(?:\w+://)?(?:[^@/]+@)?github\.com[:/]", re.I)


def parse_remote(remote):
    """(owner/name, url) of a git remote URL; last two path segments, .git stripped."""
    clean = remote.strip().rstrip("/")
    clean = clean[:-4] if clean.endswith(".git") else clean
    parts = [p for p in re.split(r"[/:]", clean) if p]
    if len(parts) < 2:
        return None, None
    name = f"{parts[-2]}/{parts[-1]}"
    return name, (f"https://github.com/{name}" if GITHUB.match(remote.strip()) else None)


def identity(path):
    try:
        out = subprocess.run(["git", "-C", str(path), "remote", "get-url", "origin"],
                             capture_output=True, text=True, timeout=10)
        remote = out.stdout.strip() if out.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        remote = ""
    name, url = parse_remote(remote) if remote else (None, None)
    return (name, url) if name else (f"local/{path.name}", None)


# ---- discovery -------------------------------------------------------------

def discover(cfg):
    """Resolved paths of the repos to report, deduplicated, only those with a factory/ directory."""
    listed = []
    try:
        subs = read_json_file(subscriptions_path())
        if isinstance(subs, dict):
            listed += subs.get("projects") or []
    except (OSError, ValueError):
        pass
    listed += cfg.get("projects") or []
    paths, seen = [], set()
    for p in [REPO] + listed:
        try:
            path = Path(p).expanduser().resolve()
        except (OSError, RuntimeError, TypeError):
            continue
        if path not in seen and (path / "factory").is_dir():
            seen.add(path)
            paths.append(path)
    return paths


def read_text(path):
    """(text, sha1) of a file, None when unreadable."""
    try:
        raw = path.read_bytes()
    except OSError:
        return None
    return raw.decode("utf-8", errors="replace"), sha(raw)


def read_jobs(path):
    """{job id: {"job": dict|None, "files": {rel path: (text, sha)}, "ticket": rel path|None}}.

    "job" is None when job.json is unreadable or half-written: the job is kept as it was."""
    jobs = {}
    for folder in sorted((path / "factory" / "jobs").glob("[!_]*/")):
        if not folder.is_dir():
            continue
        try:
            entry = {"job": None, "job_sha": None, "files": {}}
            got = read_text(folder / "job.json")
            if got:
                try:
                    job = json.loads(got[0])
                    if isinstance(job, dict):
                        entry["job"], entry["job_sha"] = job, got[1]
                except ValueError:
                    pass
            if entry["job"] is not None:
                for f in sorted(folder.rglob("*.md")):
                    if f.is_file():
                        text = read_text(f)
                        if text:
                            entry["files"][f.relative_to(folder).as_posix()] = text
            jobs[folder.name] = entry
        except OSError:
            continue
    return jobs


def read_ticket(repo_path, job):
    """(rel path, text, sha) of a job's local ticket, or None."""
    ref = job.get("issue_url")
    if not isinstance(ref, str) or not ref.startswith(".scratch/"):
        return None
    f = (repo_path / ref).resolve()
    if not f.is_relative_to((repo_path / ".scratch").resolve()):
        return None
    got = read_text(f) if f.is_file() else None
    return (ref, *got) if got else None


# ---- building a push -------------------------------------------------------

def build(cfg, repos, state, full, outside, subs):
    """(payload, new_state) for one push. `state` is this hub's part of the state file."""
    new = {}
    payload_repos = []
    seen_names = set()
    for path in repos:
        name, url = identity(path)
        if name in seen_names:
            continue
        seen_names.add(name)
        old = state.get(name) or {}
        old = old if isinstance(old, dict) else {}
        jobs = read_jobs(path)
        mine, entry_jobs, ids, tickets, tickets_sha = {}, [], [], {}, {}
        for jid, j in jobs.items():
            if j["job"] is None:
                if jid in old and jid != "_tickets":  # half-written: keep the previous state, send nothing
                    ids.append(jid)
                    mine[jid] = old[jid]
                continue
            hashes = {"job.json": j["job_sha"], **{p: t[1] for p, t in j["files"].items()}}
            prev = old.get(jid) if isinstance(old.get(jid), dict) else {}
            ids.append(jid)
            mine[jid] = hashes
            removed = sorted(set(prev) - set(hashes))
            if not full and prev == hashes:
                pass
            else:
                changed = {p: t[0] for p, t in j["files"].items() if full or prev.get(p) != t[1]}
                entry_jobs.append({"id": jid, "job": j["job"], "files": changed,
                                   "files_removed": [] if full else removed})
            tk = read_ticket(path, j["job"])
            if tk:
                tickets_sha[tk[0]] = tk[2]
                if full or (old.get("_tickets") or {}).get(tk[0]) != tk[2]:
                    tickets[tk[0]] = tk[1]
        mine["_tickets"] = tickets_sha
        item = {"repo": name, "url": url, "path": str(path), "job_ids": ids, "jobs": entry_jobs,
                "tickets": tickets}
        cfg_new = None
        got = read_text(path / "factory" / "config.json")
        if got:
            try:
                parsed = json.loads(got[0])
            except ValueError:
                parsed = None
            if isinstance(parsed, dict):
                cfg_new = got[1]
                if full or (state.get("config") or {}).get(name) != cfg_new:
                    item["config"] = parsed
        if cfg_new is None and (state.get("config") or {}).get(name):
            cfg_new = state["config"][name]  # unreadable this round: unchanged
        new.setdefault("config", {})
        if cfg_new:
            new["config"][name] = cfg_new
        new[name] = mine
        payload_repos.append(item)
    payload = {"v": 1, "machine": cfg["machine"], "sent_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
               "full": full, "repos": payload_repos}
    new.setdefault("config", {})
    if subs is not None:
        h = sha(json.dumps(subs, sort_keys=True))
        if full or state.get("subscriptions") != h:
            payload["subscriptions"] = subs
        new["subscriptions"] = h
    elif state.get("subscriptions"):
        new["subscriptions"] = state["subscriptions"]
    if outside is not None:
        h = sha(json.dumps(outside, sort_keys=True))
        if full or state.get("outside") != h:
            payload["outside"] = outside
        new["outside"] = h
    elif state.get("outside"):
        new["outside"] = state["outside"]
    return payload, new


def read_subscriptions():
    """The subscriptions list, [] without the file, None when the file is unreadable this round."""
    try:
        data = read_json_file(subscriptions_path())
    except (OSError, ValueError):
        return None
    subs = data.get("subscriptions") if isinstance(data, dict) else None
    return subs if isinstance(subs, list) else []


def outside_wanted(cfg, args):
    if args.no_outside or cfg.get("outside") is False:
        return False
    try:
        subs = read_json_file(subscriptions_path())
    except (OSError, ValueError):
        subs = None
    return not (isinstance(subs, dict) and subs.get("outside") is False)


# ---- outside usage ---------------------------------------------------------

def scan_outside():
    """The outside usage bin/dashboard serves: same sessions, prices and cache."""
    return session_usage.scan_outside()


class OutsideThread:
    """Runs the scan every OUTSIDE_EVERY seconds; `result` is the latest, None until the first pass."""

    def __init__(self):
        self.result = None
        threading.Thread(target=self.loop, daemon=True).start()

    def loop(self):
        while True:
            try:
                self.result = scan_outside()
            except Exception as err:
                say(f"outside scan failed: {str(err).splitlines()[0] if str(err) else type(err).__name__}")
            time.sleep(OUTSIDE_EVERY)


# ---- state -----------------------------------------------------------------

def load_state():
    try:
        data = json.loads(state_path().read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(state):
    path = state_path()
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(state))
        tmp.replace(path)
    except OSError as err:
        say(f"cannot write {path}: {err}")


# ---- sending ---------------------------------------------------------------

class PushFailed(Exception):
    pass


def post(cfg, payload):
    """POST the payload; the hub's answer as a dict. PushFailed with a one-line reason."""
    body = gzip.compress(json.dumps(payload).encode())
    req = urllib.request.Request(cfg["url"] + "/api/ingest", data=body, method="POST", headers={
        "Authorization": f"Bearer {cfg['token']}", "Content-Type": "application/json",
        "Content-Encoding": "gzip", "User-Agent": "factory-report"})
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            raw = resp.read()
    except urllib.error.HTTPError as err:
        raise PushFailed(f"hub answered {err.code} {err.reason}")
    except (urllib.error.URLError, OSError, ValueError) as err:
        raise PushFailed(f"cannot reach {cfg['url']}: {getattr(err, 'reason', err)}")
    try:
        data = json.loads(raw)
        return data if isinstance(data, dict) else {}
    except ValueError:
        return {}


def summary(payload):
    jobs = sum(len(r["jobs"]) for r in payload["repos"])
    files = sum(len(j["files"]) for r in payload["repos"] for j in r["jobs"])
    return (f"{'full' if payload['full'] else 'delta'}: {len(payload['repos'])} repo(s), "
            f"{jobs} job(s), {files} file(s)")


def truncated(payload):
    """A copy of the payload with every file content cut to DRY_CUT characters."""
    def cut(text):
        return text if len(text) <= DRY_CUT else f"{text[:DRY_CUT]}…({len(text)} chars)"
    out = json.loads(json.dumps(payload))
    for r in out["repos"]:
        for j in r["jobs"]:
            j["files"] = {p: cut(t) for p, t in j["files"].items()}
        r["tickets"] = {p: cut(t) for p, t in r["tickets"].items()}
    return out


def push_once(cfg, args, outside_source, dry_run=False, force_full=False):
    """One push (two when the hub asks for a full one). True when it went through."""
    repos = discover(cfg)
    all_state = load_state()
    mine = all_state.get(cfg["url"])
    mine = mine if isinstance(mine, dict) else {}
    full = bool(force_full or not mine or mine.get("need_full") or time.time() - mine.get("full_at", 0) > FULL_EVERY)
    for attempt in range(2):
        outside = outside_source() if outside_source else None
        payload, new = build(cfg, repos, mine, full, outside, read_subscriptions())
        if dry_run:
            print(json.dumps(truncated(payload), indent=2, ensure_ascii=False))
            return True
        try:
            answer = post(cfg, payload)
        except PushFailed as err:
            mine["need_full"] = True
            all_state[cfg["url"]] = mine
            save_state(all_state)
            say(str(err))
            return False
        new["full_at"] = time.time() if full else mine.get("full_at", 0)
        all_state[cfg["url"]] = new
        save_state(all_state)
        mine = new
        say(f"sent {summary(payload)} to {cfg['url']}")
        if answer.get("need_full") and not full and attempt == 0:
            full = True
            continue
        return True
    return True


# ---- modes -----------------------------------------------------------------

def install_service():
    unit = (f"[Unit]\nDescription=Report this machine's factories to the factory hub\n"
            f"After=network-online.target\n\n[Service]\nType=simple\n"
            f"ExecStart={Path(__file__).resolve()} --watch\nRestart=always\nRestartSec=10\n\n"
            f"[Install]\nWantedBy=default.target\n")
    path = Path.home() / ".config" / "systemd" / "user" / SERVICE
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(unit)
    print(f"wrote {path}")
    print("systemctl --user daemon-reload && systemctl --user enable --now factory-report")
    return 0


def watch(args):
    try:
        load_config()
    except NoConfig as err:
        say(str(err))
        return 2
    outside = OutsideThread() if not args.no_outside else None
    wait, last_error = 5.0, None
    while True:
        try:
            cfg = load_config()
            wait = cfg["interval_seconds"]
            use = outside if outside and outside_wanted(cfg, args) else None
            push_once(cfg, args, (lambda: use.result) if use else None, force_full=args.full)
            args.full = False
            last_error = None
        except NoConfig as err:
            if str(err) != last_error:
                say(str(err))
            last_error = str(err)
        except Exception as err:  # the loop never dies
            msg = f"{type(err).__name__}: {err}".splitlines()[0]
            if msg != last_error:
                say(f"error: {msg}")
            last_error = msg
        time.sleep(wait)


def main(argv):
    import argparse
    ap = argparse.ArgumentParser(prog="report", description="Report this machine's factories to the factory hub.")
    ap.add_argument("--watch", action="store_true", help="push every interval_seconds, forever")
    ap.add_argument("--full", action="store_true", help="one push with full=true")
    ap.add_argument("--dry-run", action="store_true", help="print the JSON, send nothing, write no state")
    ap.add_argument("--no-outside", action="store_true", help="skip the outside usage scan")
    ap.add_argument("--install-service", action="store_true", help="write the systemd user unit")
    args = ap.parse_args(argv)
    if args.install_service:
        return install_service()
    if args.watch:
        return watch(args)
    try:
        cfg = load_config(dry_run=args.dry_run)
    except NoConfig as err:
        say(str(err))
        return 2
    source = None
    if outside_wanted(cfg, args):
        def source():
            try:
                return scan_outside()
            except Exception as err:
                say(f"outside scan failed: {str(err).splitlines()[0] if str(err) else type(err).__name__}")
                return None
    try:
        ok = push_once(cfg, args, source, dry_run=args.dry_run, force_full=args.full)
    except Exception as err:
        say(f"error: {type(err).__name__}: {err}".splitlines()[0])
        return 1
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
