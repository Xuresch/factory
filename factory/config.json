{
  "tracker": "auto",
  "concurrency": 2,
  "max_rounds": 3,
  "max_continues": 3,
  "replace_builder_after_partials": 2,
  "hold": {
    "after_spec_risk": [
      "high"
    ]
  },
  "max_parallel_builders": 3,
  "base_branch": "main",
  "merge_method": "merge",
  "labels": {
    "queue": "ready-for-agent",
    "needs_info": "needs-info",
    "needs_human": "ready-for-human",
    "returned": "needs-triage",
    "wontfix": "wontfix"
  },
  "stages": {
    "intake": {
      "agent": "claude",
      "model": "opus"
    },
    "spec": {
      "agent": "claude",
      "model": "opus"
    },
    "approver": {
      "agent": "claude",
      "model": "opus"
    },
    "retro": {
      "agent": "claude",
      "model": "sonnet"
    }
  },
  "builder": {
    "default": {
      "agent": "codex",
      "model": "gpt-6.1-terra",
      "effort": "high"
    },
    "fallback": {
      "agent": "claude",
      "model": "opus"
    },
    "fallback_on_changes_from": [
      "ux",
      "ui"
    ],
    "by_risk": {
      "low": {
        "agent": "codex",
        "model": "gpt-6.1-terra",
        "effort": "low"
      },
      "medium": {
        "agent": "codex",
        "model": "gpt-6.1-terra",
        "effort": "high"
      },
      "high": {
        "agent": "codex",
        "model": "gpt-6.1-sol",
        "effort": "high"
      }
    }
  },
  "routing": {
    "low": {
      "code": {
        "agent": "claude",
        "model": "sonnet"
      }
    },
    "medium": {
      "code": {
        "agent": "claude",
        "model": "opus"
      }
    },
    "high": {
      "code": {
        "agent": "claude",
        "model": "opus"
      }
    }
  },
  "surface_reviewers": {
    "ui": {
      "ux": {
        "agent": "claude",
        "model": "sonnet"
      },
      "ui": {
        "agent": "claude",
        "model": "sonnet"
      }
    },
    "security": {
      "security": {
        "agent": "claude",
        "model": "sonnet"
      }
    }
  },
  "cross_review": {
    "lenses": [
      "code",
      "security"
    ],
    "when_builder_is": {
      "codex": {
        "agent": "claude",
        "model": "opus"
      },
      "claude": {
        "agent": "codex",
        "model": "gpt-6.1-sol",
        "effort": "medium"
      }
    }
  },
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json",
    "factory/agents/*",
    "factory/bin/*",
    "factory/env.sh"
  ],
  "ports": {
    "base": 5100,
    "step": 10
  },
  "prices_usd_per_mtok": {
    "claude-fable-5-1": {
      "input": 10.0,
      "output": 50.0,
      "cache_write_5m": 12.5,
      "cache_write_1h": 20.0,
      "cache_read": 0.25
    },
    "claude-opus-5-5": {
      "input": 4.0,
      "output": 20.0,
      "cache_write_5m": 5.0,
      "cache_write_1h": 8.0,
      "cache_read": 0.2
    },
    "claude-sonnet-5-5": {
      "input": 2.0,
      "output": 10.0,
      "cache_write_5m": 2.5,
      "cache_write_1h": 4.0,
      "cache_read": 0.2
    },
    "claude-haiku-5-5": {
      "input": 0.1,
      "output": 0.5,
      "cache_write_5m": 0.125,
      "cache_write_1h": 0.2,
      "cache_read": 0.01
    },
    "gpt-6.1-terra": {
      "input": 1.0,
      "cached_input": 0.05,
      "cache_write": 1.25,
      "output": 5.0
    },
    "claude-fable-5-2": {
      "input": 8.0,
      "output": 40.0,
      "cache_write_5m": 10.0,
      "cache_write_1h": 16.0,
      "cache_read": 0.2
    },
    "gpt-6.1-sol": {
      "input": 2.0,
      "cached_input": 0.1,
      "cache_write": 2.5,
      "output": 10.0
    }
  },
  "review_sections": {
    "code": [
      "Standards",
      "Spec"
    ]
  },
  "review_skip": {},
  "max_cost_usd": null,
  "notify": "auto",
  "orchestrator_stale_minutes": 120,
  "retro_after_merge": "friction",
  "feature_review": true,
  "keep_open_roles": [
    "builder"
  ],
  "worktree_root": null,
  "worktree_cache_dirs": [],
  "stages_by_risk": {
    "spec": {
      "low": {
        "agent": "claude",
        "model": "sonnet"
      }
    },
    "approver": {
      "low": {
        "agent": "claude",
        "model": "sonnet"
      }
    }
  },
  "skip_spec_when": {
    "size": [
      "small"
    ],
    "risk": [
      "low"
    ]
  },
  "risk_upgrades": {
    "high": {
      "security": {
        "agent": "claude",
        "model": "opus"
      }
    }
  },
  "commit_tickets": true,
  "retro_cost_usd": null,
  "rerun_every_round": {
    "low": [
      "code"
    ],
    "medium": [
      "code"
    ],
    "high": [
      "code",
      "security"
    ]
  },
  "model_presets": {
    "terra-low": {
      "agent": "codex",
      "model": "gpt-6.1-terra",
      "effort": "low"
    },
    "terra-high": {
      "agent": "codex",
      "model": "gpt-6.1-terra",
      "effort": "high"
    },
    "sol-medium": {
      "agent": "codex",
      "model": "gpt-6.1-sol",
      "effort": "medium"
    },
    "sol-high": {
      "agent": "codex",
      "model": "gpt-6.1-sol",
      "effort": "high"
    }
  }
}
